{
	"name": "@clusterio/lib",
	"version": "2.0.3",
	"description": "Shared library for Clusterio",
	"homepage": "https://github.com/clusterio/clusterio#readme",
	"author": "Hornwitser <github@hornwitser.no>",
	"license": "MIT",

	"keywords": [
		"clusterio",
		"factorio"
	],

	"repository": {
		"type": "git",
		"url": "https://github.com/clusterio/clusterio"
	},
	"bugs": {
		"url": "https://github.com/clusterio/clusterio/issues"
	},
	"publishConfig": {
		"access": "public"
	},

	"type": "module",
	"imports": {
		"#WebSocket": {
			"node": {
				"types": "./src/link/WebSocket.node.ts",
				"default": "./dist/node/src/link/WebSocket.node.js"
			},
			"import": "./src/link/WebSocket.browser.ts"
		},
		"#is_deep_strict_equal": {
			"node": {
				"types": "./src/is_deep_strict_equal.node.ts",
				"default": "./dist/node/src/is_deep_strict_equal.node.js"
			},
			"import": "./src/is_deep_strict_equal.browser.ts"
		}
	},
	"browser": "browser.ts",
	"main": "dist/node/index.js",
	"scripts": {
		"prepare": "tsc --build && pnpm run compile_validator",
		"compile_validator": "node scripts/compile_validator.js"
	},
	"engines": {
		"node": ">=22"
	},

	"dependencies": {
		"@sinclair/typebox": "catalog:",
		"@types/yauzl": "catalog:",
		"@types/yazl": "catalog:",
		"ajv": "^8.20.0",
		"chalk": "catalog:",
		"fast-deep-equal": "^3.1.3",
		"set-blocking": "catalog:",
		"triple-beam": "^1.4.1",
		"winston": "catalog:",
		"winston-transport": "catalog:",
		"ws": "catalog:",
		"yargs": "catalog:",
		"yauzl": "catalog:",
		"yazl": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/set-blocking": "catalog:",
		"@types/triple-beam": "^1.3.5",
		"@types/ws": "catalog:",
		"@types/yargs": "catalog:",
		"typescript": "catalog:"
	}
}
