{
	"name": "root",
	"private": true,
	"files": [],
	"packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
	"type": "module",
	"scripts": {
		"build": "tsc --build",
		"watch": "tsc --build --watch",
		"build-mod": "pnpm run -r build-mod --output-dir ../../dist",
		"test": "pnpm run build && NODE_EXTRA_CA_CERTS=$(pwd)/test/file/tls/cert.pem mocha --enable-source-maps --check-leaks -R spec --recursive test \"plugins/*/test/**\" --exclude \"test/manual/**\"",
		"silent-test": "SILENT_TEST=y pnpm test",
		"fast-test": "FAST_TEST=y pnpm test",
		"no-external-test": "NO_EXTERNAL_TEST=y pnpm test",
		"cover": "c8 pnpm test",
		"fast-cover": "FAST_TEST=y c8 pnpm test",
		"ci-cover": "c8 --reporter=lcovonly pnpm test",
		"lint": "eslint packages plugins test",
		"lint-fix": "eslint --fix packages plugins test",
		"clean": "node ./clean.js",
		"docs": "typedoc",
		"bundle-dependencies": "bundle-dependencies"
	},
	"c8": {
		"exclude": [
			"test/**",
			"plugins/*/test/**",
			"temp/**"
		]
	},
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"packages/*",
		"plugins/*",
		"external_plugins/*",
		"external_plugins/*/*"
	],
	"devDependencies": {
		"@clusterio/controller": "workspace:^",
		"@clusterio/ctl": "workspace:^",
		"@clusterio/host": "workspace:^",
		"@clusterio/lib": "workspace:^",
		"@clusterio/web_ui": "workspace:^",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@swc/core": "catalog:",
		"@types/node": "catalog:",
		"c8": "^12.0.0",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.10.0",
		"eslint-plugin-node": "^11.1.0",
		"express": "catalog:",
		"form-data": "^4.0.6",
		"globals": "^17.12.0",
		"jsonwebtoken": "catalog:",
		"jszip": "catalog:",
		"mocha": "^11.8.0",
		"typedoc": "^0.28.20",
		"typescript": "catalog:",
		"yargs": "catalog:"
	}
}
